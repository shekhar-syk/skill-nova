# SKILLNOVA Environment Configuration (Placeholders Only)
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Aiven PostgreSQL Connection (with SSL — REQUIRED in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require"

# JWT Authentication Secrets (REQUIRED in production)
JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google Gemini AI (Server-side only — never expose to client)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
ALLOW_SANDBOX_PAYMENTS="true"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Resend Transactional Email
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="SKILLNOVA <noreply@skillnova.edu>"
ADMIN_NOTIFICATION_EMAIL="admissions@skillnova.edu"

# Client API Base (optional when served via proxy or Vercel->Render)
VITE_API_BASE_URL="/api"
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
